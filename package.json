{
    "name": "SHRED",
    "displayName": "SHRED",
    "version": "3.2.0",
    "description": "Browser Extension: Guitar tabs for music streaming services",
    "author": "Ohad Cohen <ohadc.me@gmail.com>",
    "packageManager": "pnpm@11.9.0",
    "scripts": {
        "dev": "wxt",
        "build": "wxt build",
        "package": "wxt zip",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "postinstall": "wxt prepare",
        "lint": "eslint src/** --cache && prettier --check '**/*.{ts,tsx,scss,json}' --cache --cache-strategy metadata",
        "format": "prettier --write **/*.{ts,tsx,scss,json}"
    },
    "dependencies": {
        "@fontsource-variable/figtree": "^5.3.0",
        "@tanstack/react-query": "^5.90.7",
        "clsx": "^2.1.1",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-hotkeys-hook": "^5.2.1",
        "rxjs": "^7.8.2",
        "tailwind-merge": "^2.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@tanstack/eslint-plugin-query": "^5.91.2",
        "@types/chrome": "0.1.27",
        "@types/node": "24.10.0",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "@wxt-dev/auto-icons": "^1.1.2",
        "@wxt-dev/module-react": "^1.2.2",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "postcss": "^8.5.6",
        "prettier": "3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "sass": "^1.105.0",
        "tailwindcss": "^3.4.17",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.46.3",
        "vitest": "^5.0.2",
        "wxt": "^0.21.4"
    }
}
