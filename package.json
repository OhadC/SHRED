{
    "name": "SHRED",
    "displayName": "SHRED",
    "version": "3.2.0",
    "description": "Browser Extension: Guitar tabs for music streaming services",
    "author": "Plasmo Corp. <foss@plasmo.com>",
    "scripts": {
        "dev": "plasmo dev",
        "build": "plasmo build",
        "package": "plasmo package",
        "lint": "eslint src/** --cache && prettier --check '**/*.{ts,tsx,scss,json}' --cache --cache-strategy metadata",
        "format": "prettier --write **/*.{ts,tsx,scss,json}"
    },
    "dependencies": {
        "@plasmohq/messaging": "^0.7.2",
        "@tanstack/react-query": "^5.90.7",
        "clsx": "^2.1.1",
        "js-logger": "^1.6.1",
        "lodash": "^4.17.21",
        "plasmo": "0.90.5",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-hotkeys-hook": "^5.2.1",
        "rxjs": "^7.8.2",
        "tailwind-merge": "^2.6.0",
        "tsyrinx": "^1.0.3",
        "webextension-polyfill": "^0.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@tanstack/eslint-plugin-query": "^5.91.2",
        "@types/chrome": "0.1.27",
        "@types/lodash": "^4.17.20",
        "@types/node": "24.10.0",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "@types/webextension-polyfill": "^0.12.4",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "postcss": "^8.5.6",
        "prettier": "3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "tailwindcss": "^3.4.17",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.46.3"
    },
    "manifest": {
        "host_permissions": [
            "https://*.songsterr.com/*"
        ],
        "permissions": [
            "tabs",
            "declarativeContent"
        ]
    }
}
